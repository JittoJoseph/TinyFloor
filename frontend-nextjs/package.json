{
  "name": "frontend-nextjs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "node scripts/fetch-assets.mjs && node scripts/copy-noise.mjs && next dev --webpack",
    "build": "node scripts/fetch-assets.mjs && node scripts/copy-noise.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "build:worker": "opennextjs-cloudflare build && node scripts/static-pages.mjs",
    "preview": "pnpm run build:worker && opennextjs-cloudflare preview",
    "deploy:worker": "node ../tools/deploy.mjs worker:production worker:preview",
    "deploy:preview": "node ../tools/deploy.mjs worker:production worker:preview --preview",
    "worker:production": "opennextjs-cloudflare deploy",
    "worker:preview": "opennextjs-cloudflare deploy --env preview",
    "upload:worker": "opennextjs-cloudflare upload",
    "indexnow": "node scripts/indexnow.mjs",
    "assets": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "@opennextjs/cloudflare": "1.20.6",
    "@phosphor-icons/react": "^2.1.10",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.556.0",
    "motion": "^13.4.0",
    "next": "^16.0.7",
    "next-intl": "^4.14.2",
    "phaser": "^3.90.0",
    "posthog-js": "^1.407.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.131.1"
  }
}
