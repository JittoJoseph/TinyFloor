# What a production build points at. The Worker's build variables override these
# if they are set; keeping them here means a build is never one missing dashboard
# setting away from pointing at localhost. All of these are public values.
NEXT_PUBLIC_API_URL=https://api.tinyfloor.com/v1
NEXT_PUBLIC_REALTIME_URL=wss://realtime.tinyfloor.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAE6AVMD41Jo_qCYG
NEXT_PUBLIC_SITE_URL=https://www.tinyfloor.com
NEXT_PUBLIC_GA_ID=G-T6641HG7L3
# No anonymous usage reports from builds.
NEXT_TELEMETRY_DISABLED=1
