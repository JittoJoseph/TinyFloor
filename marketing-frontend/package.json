{
  "name": "marketing-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "node ../web-shared/scripts/fetch-assets.mjs --only=characters/presets/ && next dev",
    "build": "node ../web-shared/scripts/fetch-assets.mjs --only=characters/presets/ && next build",
    "start": "next start",
    "lint": "eslint",
    "build:worker": "opennextjs-cloudflare build && node ../web-shared/scripts/static-pages.mjs",
    "preview": "pnpm run build:worker && opennextjs-cloudflare preview",
    "deploy:worker": "node ../tools/deploy.mjs worker:production worker:preview",
    "deploy:preview": "node ../tools/deploy.mjs worker:production worker:preview --preview",
    "worker:production": "opennextjs-cloudflare deploy",
    "worker:preview": "opennextjs-cloudflare deploy --env preview",
    "upload:worker": "opennextjs-cloudflare upload",
    "indexnow": "node scripts/indexnow.mjs",
    "assets": "node ../web-shared/scripts/fetch-assets.mjs --only=characters/presets/"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "catalog:",
    "@hugeicons/react": "catalog:",
    "clsx": "catalog:",
    "motion": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "posthog-js": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
