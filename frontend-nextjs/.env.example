# TinyFloor API (tinyfloor-api). Locally: cd worker-api && pnpm dev
NEXT_PUBLIC_API_URL=http://localhost:8787/v1

# Rooms (tinyfloor-realtime). Locally: cd worker-realtime && pnpm dev
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8788

# Turnstile. This is Cloudflare's always-pass test key, for local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# NEXT_PUBLIC_GA_ID=G-T6641HG7L3
NEXT_PUBLIC_SITE_URL=https://www.tinyfloor.com
# Google sign-in: the OAuth client ID (the API holds its secret). Without it the button is hidden.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# PostHog product analytics. Copy these values from the PostHog project settings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
