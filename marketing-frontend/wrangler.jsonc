{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinyfloor",
  // The marketing site (www.tinyfloor.com): the home page, pricing, guides, the
  // legal pages. The app is ../app-frontend, a Worker of its own (docs/21).
  // OpenNext's worker behind a front door that serves built pages as files (cf-worker.mjs).
  "main": "cf-worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tinyfloor"
    }
  ],
  "routes": [
    { "pattern": "www.tinyfloor.com", "custom_domain": true },
    { "pattern": "tinyfloor.com", "custom_domain": true },
    { "pattern": "spatialmeet.jittojoseph.xyz", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  // preview.tinyfloor.com: the site built from dev.
  "env": {
    "preview": {
      "name": "tinyfloor-preview",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "tinyfloor-preview" }],
      "routes": [{ "pattern": "preview.tinyfloor.com", "custom_domain": true }],
      "observability": { "enabled": true }
    }
  }
}
