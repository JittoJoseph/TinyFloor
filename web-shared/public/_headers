/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

/fonts/*
  Cache-Control: public,max-age=31536000,immutable

# The floor's map and sprites keep their names when they change, so they are
# kept briefly, then used while being checked again in the background.
/tilesets/*
  Cache-Control: public,max-age=600,stale-while-revalidate=86400

/characters/*
  Cache-Control: public,max-age=600,stale-while-revalidate=86400

/credits.txt
  X-Robots-Tag: noindex

/page-fingerprints.json
  Cache-Control: no-cache
  X-Robots-Tag: noindex

# Checked on every visit, so a new one takes over at once.
/sw.js
  Cache-Control: no-cache
