{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinyfloor-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [{ "pattern": "realtime.tinyfloor.com", "custom_domain": true }],
  "vars": {
    "SITE_ORIGINS": "https://www.tinyfloor.com,https://tinyfloor.com"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "CHAT", "class_name": "Chat" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "LobbyRouter"] },
    { "tag": "v2", "renamed_classes": [{ "from": "LobbyRouter", "to": "Presence" }] },
    { "tag": "v3", "new_sqlite_classes": ["Chat"] },
    // Rooms count their own people now; see docs/07-services.md.
    { "tag": "v4", "deleted_classes": ["Presence"] }
  ],
  // Only usage_daily is written from here; the schema belongs to tinyfloor-api.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tinyfloor-db",
      "database_id": "31aa401c-c9f4-4653-8bf4-57e84881a451",
      "migrations_dir": "../worker-api/migrations"
    }
  ],
  // The rooms of the preview system, with the preview database behind them. Every
  // push to dev that touches worker-realtime/ or shared-protocol/ deploys them (the
  // tinyfloor-realtime-preview Workers Builds project runs `pnpm run deploy:preview`).
  "env": {
    "preview": {
      "name": "tinyfloor-realtime-preview",
      "routes": [{ "pattern": "realtime-preview.tinyfloor.com", "custom_domain": true }],
      "vars": { "SITE_ORIGINS": "https://preview.tinyfloor.com,http://localhost:3000" },
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "Room" },
          { "name": "CHAT", "class_name": "Chat" }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tinyfloor-preview-db",
          "database_id": "fa83d1fc-0e79-419c-a143-8934afb312c1",
          "migrations_dir": "../worker-api/migrations"
        }
      ],
      "observability": { "enabled": true }
    }
  }
}
