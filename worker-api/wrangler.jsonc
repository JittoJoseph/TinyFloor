{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinyfloor-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [{ "pattern": "api.tinyfloor.com", "custom_domain": true }],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "SITE_ORIGINS": "https://app.tinyfloor.com,https://www.tinyfloor.com,https://tinyfloor.com",
    "COOKIE_DOMAIN": ".tinyfloor.com",
    "SESSION_COOKIE": "tf_session",
    "REALTIME_URL": "wss://realtime.tinyfloor.com",
    // Google sign-in's OAuth client (public); its secret is GOOGLE_CLIENT_SECRET.
    "GOOGLE_CLIENT_ID": "523187100801-n4t184tjomdgrcf41u6k57egldkbf72k.apps.googleusercontent.com",
    // Paid plans against Paddle's live account (src/billing.ts). Billing stays
    // off until the secrets PADDLE_API_KEY and PADDLE_WEBHOOK_SECRET are set too.
    "PADDLE_ENV": "production",
    "PADDLE_CLIENT_TOKEN": "live_55102c832ba8a095d641248119f",
    "PADDLE_PRICES": "{\"plus\":\"pri_01m3mk0jr1pdasbhgzad26dww5\",\"pro\":\"pri_01m3mk0k34tpeb6s2f8dtjy79a\"}"
  },
  "durable_objects": { "bindings": [{ "name": "PASSWORD_GUARD", "class_name": "PasswordGuard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PasswordGuard"] }],
  // Per-IP limit on sign-up, sign-in and guest creation (src/limits.ts).
  // Secrets, set with `wrangler secret put` (and in .dev.vars locally): TICKET_SECRET,
  // TURNSTILE_SECRET, TURN_KEY_ID, TURN_KEY_API_TOKEN, GOOGLE_CLIENT_SECRET, and
  // ADMIN_EMAILS, the comma-separated accounts that can open /admin.
  "ratelimits": [{ "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "services": [{ "binding": "REALTIME", "service": "tinyfloor-realtime", "entrypoint": "RealtimeAdmin" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tinyfloor-db",
      "database_id": "31aa401c-c9f4-4653-8bf4-57e84881a451",
      "migrations_dir": "migrations"
    }
  ],
  // The preview system: the same code with its own database, so anything tried
  // on preview.tinyfloor.com never touches real accounts or offices. TURN and
  // the SFU are the same services; only the credentials differ. Every push to dev
  // that touches worker-api/ or shared-protocol/ deploys it (the tinyfloor-api-preview
  // Workers Builds project runs `pnpm run deploy:preview`, migrations first).
  "env": {
    "preview": {
      "name": "tinyfloor-api-preview",
      "routes": [{ "pattern": "api-preview.tinyfloor.com", "custom_domain": true }],
      "vars": {
        "SITE_ORIGINS": "https://app-preview.tinyfloor.com,https://preview.tinyfloor.com,http://localhost:3001,http://localhost:3000",
        // No Domain on the cookie, and a name of its own, so a live session in
        // the same browser neither reaches preview nor shadows it.
        "COOKIE_DOMAIN": "",
        "SESSION_COOKIE": "tf_preview_session",
        "REALTIME_URL": "wss://realtime-preview.tinyfloor.com",
        "GOOGLE_CLIENT_ID": "523187100801-n4t184tjomdgrcf41u6k57egldkbf72k.apps.googleusercontent.com",
        // Paid plans against Paddle's sandbox (src/billing.ts): the client-side
        // token is public by design; PADDLE_API_KEY and PADDLE_WEBHOOK_SECRET are
        // secrets.
        "PADDLE_ENV": "sandbox",
        "PADDLE_CLIENT_TOKEN": "test_4ed348cc09ff782ef94572163bf",
        "PADDLE_PRICES": "{\"plus\":\"pri_01m3kcx9ffg4gtchefr77ke5nk\",\"pro\":\"pri_01m3kd4kf3a3547dnr863hrev4\"}"
      },
      "durable_objects": { "bindings": [{ "name": "PASSWORD_GUARD", "class_name": "PasswordGuard" }] },
      "ratelimits": [{ "name": "AUTH_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }],
      "services": [{ "binding": "REALTIME", "service": "tinyfloor-realtime-preview", "entrypoint": "RealtimeAdmin" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tinyfloor-preview-db",
          "database_id": "fa83d1fc-0e79-419c-a143-8934afb312c1",
          "migrations_dir": "migrations"
        }
      ],
      "observability": { "enabled": true },
      // The daily clean-up runs on the live system only.
      "triggers": { "crons": [] }
    }
  }
}
