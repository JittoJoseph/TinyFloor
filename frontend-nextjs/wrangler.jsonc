{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinyfloor",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tinyfloor"
    }
  ],
  "routes": [
    { "pattern": "www.tinyfloor.com", "custom_domain": true },
    { "pattern": "tinyfloor.com", "custom_domain": true },
    { "pattern": "spatialmeet.jittojoseph.xyz", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  // Variables set in the dashboard (MAINTENANCE, MAINTENANCE_BYPASS) survive deploys.
  "keep_vars": true
}
