{
  "name": "tinyfloor-realtime",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "node ../tools/deploy.mjs release:production release:preview",
    "deploy:preview": "node ../tools/deploy.mjs release:production release:preview --preview",
    "release:production": "wrangler deploy",
    "release:preview": "wrangler deploy --env preview",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.10",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.132.0"
  }
}
