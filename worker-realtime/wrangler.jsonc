{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinyfloor-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [{ "pattern": "realtime.tinyfloor.com", "custom_domain": true }],
  "vars": {
    "SITE_ORIGINS": "https://www.tinyfloor.com,https://preview.tinyfloor.com,http://localhost:3000"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "PRESENCE", "class_name": "Presence" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "LobbyRouter"] },
    { "tag": "v2", "renamed_classes": [{ "from": "LobbyRouter", "to": "Presence" }] }
  ],
  // Only usage_daily is written from here; the schema belongs to tinyfloor-api.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tinyfloor-db",
      "database_id": "31aa401c-c9f4-4653-8bf4-57e84881a451",
      "migrations_dir": "../worker-api/migrations"
    }
  ]
}
