{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinyfloor-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [{ "pattern": "realtime.tinyfloor.com", "custom_domain": true }],
  "vars": {
    "SITE_ORIGINS": "https://www.tinyfloor.com,https://preview.tinyfloor.com,http://localhost:3000"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "LobbyRouter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "LobbyRouter"] }]
}
